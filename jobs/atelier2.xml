<?xml version="1.0" encoding="UTF-8"?>
<alambic version="2.0">
	<variables>
 		<variable name="RESOURCES_PATH">../resources</variable>
 		<variable name="OUTPUT_PATH">../output</variable>
		<variable name="DEFAULT_SALT">SALT_123456</variable>
	</variables>

    <jobs>

		<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			 Atelier #2	- Anonymiser en cohérence les données personnelles de deux fichiers XML.
			 - Recopie en miroir des fichiers sources par exploration récursive du fichier.
			 - Illustration de la capture et anonymisation des données personnelles.
			 - Illustration de la reproductibilité de l'anonymisation d'une donnée par signature numérique.
		     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
        <job name="anonymization-job-atelier2">
        	<execute-job name="anonymization-job-atelier2-customers"/>
        	<execute-job name="anonymization-job-atelier2-orders"/>
        </job>

		<!-- Anonymisation du premier fichier 'atelier2-file1-to-anonymize.xml' -->
        <job name="anonymization-job-atelier2-customers">
            <resources>
                <resource type="randomIntegerGenerator" name="randomIntegerGenerator" dynamic="true"/>
                <resource type="randomUserGenerator" name="randomUserGenerator" dynamic="true"/>
                <resource type="randomDateGenerator" name="randomDateGenerator" dynamic="true"/>
                <resource type="randomMailGenerator" name="randomMailGenerator" dynamic="true"/>
				<resource type="blurIdGenerator" name="blurIdGenerator" dynamic="true">
					<salt>%DEFAULT_SALT%</salt>
				</resource>
            </resources>
            <destination type="file" name="atelier2-anonymized-customers.xml">
            	<xmlfile name="atelier2FileToAnonymize">src/test/resources/atelier2/atelier2-customers-to-anonymize.xml</xmlfile>
                <template>%RESOURCES_PATH%/atelier2/atelier2-template-customers.ftl</template>
                <output>%OUTPUT_PATH%/atelier2-anonymized-customers.xml</output>
            </destination>
        </job>

		<!-- Anonymisation du second fichier 'atelier2-file2-to-anonymize.xml' -->
        <job name="anonymization-job-atelier2-orders">
            <resources>
                <resource type="randomIntegerGenerator" name="randomIntegerGenerator" dynamic="true"/>
                <resource type="randomUserGenerator" name="randomUserGenerator" dynamic="true"/>
				<resource type="blurIdGenerator" name="blurIdGenerator" dynamic="true">
					<salt>%DEFAULT_SALT%</salt>
				</resource>
            </resources>
            <destination type="file" name="atelier2-anonymized-orders.xml">
            	<xmlfile name="atelier2FileToAnonymize">src/test/resources/atelier2/atelier2-orders-to-anonymize.xml</xmlfile>
                <template>%RESOURCES_PATH%/atelier2/atelier2-template-orders.ftl</template>
                <output>%OUTPUT_PATH%/atelier2-anonymized-orders.xml</output>
            </destination>
        </job>

    </jobs>
</alambic>