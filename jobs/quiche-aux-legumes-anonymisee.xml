        </job>

        <job name="BuildAnonymizationRecipe">
            <resources>
                <resource type="randomIntegerGenerator" name="randomIntegerGenerator" dynamic="true"/>
                <resource type="randomUserGenerator" name="randomUserGenerator" dynamic="true"/>
                <resource type="randomDateGenerator" name="randomDateGenerator" dynamic="true"/>
                <resource type="randomMailGenerator" name="randomMailGenerator" dynamic="true"/>
                <resource type="randomUAIGenerator" name="randomUAIGenerator" dynamic="true"/>
                <resource type="randomUidGenerator" name="randomUidGenerator" dynamic="true"/>
                <resource type="randomUUidGenerator" name="randomUUidGenerator" dynamic="true"/>
                <resource type="randomPasswordGenerator" name="randomPasswordGenerator" dynamic="true"/>
                <resource type="fileExplorer" name="listFichiersAAnonymiser">
                    <query>{"rootPath": "src/test/resources/quiche-aux-legumes-anonymisee/", "filterRegex": "quicheAuxLegumesAAnonymiser1.xml"}</query>
                </resource>
            </resources>
            <destination type="file" name="quicheAuxLegumesAnonymisee.xml">
                <template>%RESOURCES_PATH%/quiche-aux-legumes-anonymisee/anonymize_recipe.ftl</template>
                <output>%OUTPUT_PATH%/quicheAuxLegumesAnonymisee.xml</output>
            </destination>
        </job>

