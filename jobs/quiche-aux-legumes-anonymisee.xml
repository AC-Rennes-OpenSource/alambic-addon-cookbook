<?xml version="1.0" encoding="UTF-8"?>
<alambic version="2.0">
	<variables>
 		<variable name="RESOURCES_PATH">../resources</variable>
 		<variable name="OUTPUT_PATH">../output</variable>
		<variable name="DEFAULT_SALT">${Fn.getRandomSalt(16)}</variable>
	</variables>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                                 Build anonymization recipe								 -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <jobs>

        <job name="BuildAnonymizationRecipeWithIdenticalContextsAndKeys">
            <execute-job name="BuildAnonymizationRecipeWithIdenticalContextsAndKeys1"/>
            <execute-job name="BuildAnonymizationRecipeWithIdenticalContextsAndKeys2"/>
        </job>

        <job name="BuildAnonymizationRecipeWithIdenticalContextsAndDistinctKeys">
            <execute-job name="BuildAnonymizationRecipeWithIdenticalContextsAndDistinctKeys1"/>
