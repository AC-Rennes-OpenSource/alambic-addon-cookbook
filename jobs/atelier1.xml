<?xml version="1.0" encoding="UTF-8"?>
<alambic version="2.0">
	<variables>
 		<variable name="RESOURCES_PATH">../resources</variable>
 		<variable name="OUTPUT_PATH">../output</variable>
		<variable name="DEFAULT_SALT">SALT_123456</variable>
	</variables>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                                 Atelier #1	- Job description							 -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <jobs>

        <job name="anonymization-job">
            <resources>
                <resource type="randomIntegerGenerator" name="randomIntegerGenerator" dynamic="true"/>
                <resource type="randomUserGenerator" name="randomUserGenerator" dynamic="true"/>
                <resource type="randomDateGenerator" name="randomDateGenerator" dynamic="true"/>
                <resource type="randomMailGenerator" name="randomMailGenerator" dynamic="true"/>
                <resource type="randomUAIGenerator" name="randomUAIGenerator" dynamic="true"/>
                <resource type="randomUidGenerator" name="randomUidGenerator" dynamic="true"/>
                <resource type="randomUUidGenerator" name="randomUUidGenerator" dynamic="true"/>
                <resource type="randomPasswordGenerator" name="randomPasswordGenerator" dynamic="true"/>
				<resource type="blurIdGenerator" name="blurIdGenerator" dynamic="true">
					<salt>%DEFAULT_SALT%</salt>
				</resource>
            </resources>
            <destination type="file" name="atelier1-anonymized-file.xml">
            	<xmlfile name="atelier1FileToAnonymize">src/test/resources/atelier1/atelier1-file-to-anonymize.xml</xmlfile>
                <template>%RESOURCES_PATH%/atelier1/atelier1-template.ftl</template>
                <output>%OUTPUT_PATH%/atelier1-anonymized-file.xml</output>
            </destination>
        </job>

    </jobs>
</alambic>